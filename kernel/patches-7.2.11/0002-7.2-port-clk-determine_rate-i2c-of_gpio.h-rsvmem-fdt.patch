From: kazu <kazu@dynabook.local>
Date: Sun, 18 Oct 2026 20:59:40 +0900
Subject: [PATCH 2/5] 7.2 port: clk determine_rate, i2c of_gpio.h, rsvmem
 fdt_node, pcie msi_parent_ops

---
 drivers/clk/realtek/clk-rtd129x-scpu.c | 14 +++---
 drivers/i2c/busses/i2c-rtk.c           |  1 -
 drivers/pci/controller/Kconfig         | 16 +++++++
 drivers/pci/controller/pcie-rtd129x.c  | 63 +++++++++++---------------
 drivers/soc/realtek/rtk-memory-remap.c | 11 ++++-
 5 files changed, 60 insertions(+), 45 deletions(-)

diff --git a/drivers/clk/realtek/clk-rtd129x-scpu.c b/drivers/clk/realtek/clk-rtd129x-scpu.c
index 512ea3637..575413ebf 100644
--- a/drivers/clk/realtek/clk-rtd129x-scpu.c
+++ b/drivers/clk/realtek/clk-rtd129x-scpu.c
@@ -167,21 +167,23 @@ static const struct rtd129x_scpu_freq *rtd129x_scpu_find_freq_by_val(u32 val)
 	return NULL;
 }
 
-static long rtd129x_scpu_clk_round_rate(struct clk_hw *hw, unsigned long rate,
-					 unsigned long *parent_rate)
+/* 7.x: clk_ops.round_rate was removed; the same lookup now answers .determine_rate */
+static int rtd129x_scpu_clk_determine_rate(struct clk_hw *hw,
+					   struct clk_rate_request *req)
 {
 	const struct rtd129x_scpu_div *dv;
 	const struct rtd129x_scpu_freq *fv;
 
-	dv = rtd129x_scpu_find_div(rate);
+	dv = rtd129x_scpu_find_div(req->rate);
 	if (!dv)
 		return -EINVAL;
 
-	fv = rtd129x_scpu_find_freq(rate * dv->div);
+	fv = rtd129x_scpu_find_freq(req->rate * dv->div);
 	if (!fv)
 		return -EINVAL;
 
-	return fv->rate / dv->div;
+	req->rate = fv->rate / dv->div;
+	return 0;
 }
 
 static unsigned long rtd129x_scpu_clk_recalc_rate(struct clk_hw *hw,
@@ -257,7 +259,7 @@ static int rtd129x_scpu_clk_set_rate(struct clk_hw *hw, unsigned long rate,
 }
 
 static const struct clk_ops rtd129x_scpu_clk_ops = {
-	.round_rate  = rtd129x_scpu_clk_round_rate,
+	.determine_rate = rtd129x_scpu_clk_determine_rate,
 	.recalc_rate = rtd129x_scpu_clk_recalc_rate,
 	.set_rate    = rtd129x_scpu_clk_set_rate,
 };
