+static void rtd129x_pcie_retrain_work(struct work_struct *ws)
+{
+	struct rtd129x_pcie_priv *data = container_of(ws, struct rtd129x_pcie_priv, retrain_work);
+	struct pci_host_bridge *bridge = pci_host_bridge_from_priv(data);
+	struct pci_dev *dev, *temp;
+	int ret;
+
+	if (time_before(jiffies, data->last_retrain + 10 * HZ)) {
+		dev_info(&data->pdev->dev, "retrain: rate limited\n");
+		return;
+	}
+	data->last_retrain = jiffies;
+	data->cfg_timeouts = 0;
+
+	dev_warn(&data->pdev->dev, "retrain: link lost (MAC_ST 0x%08x), resetting EP and retraining\n",
+		 readl_relaxed(data->ctrl_base + REG_MAC_ST));
+
+	/* 死んだデバイスを先に外す（EP をリセットするので config 状態は消える） */
+	pci_walk_bus(bridge->bus, pci_dev_set_disconnected, NULL);
+	pci_lock_rescan_remove();
+	list_for_each_entry_safe_reverse(dev, temp, &bridge->bus->devices, bus_list) {
+		pci_dev_get(dev);
+		pci_stop_and_remove_bus_device(dev);
+		pci_dev_put(dev);
+	}
+	pci_unlock_rescan_remove();
+
+	ret = rtd129x_pcie_link_bringup(data);
+	if (ret) {
+		dev_err(&data->pdev->dev, "retrain: link still down (%d)\n", ret);
+		return;
+	}
+	dev_info(&data->pdev->dev, "retrain: link up, rescanning slot\n");
+	data->cfg_timeouts = 0;
+	queue_work(data->wq, &data->link_work);
+}
+
+static ssize_t retrain_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct rtd129x_pcie_priv *data = dev_get_drvdata(dev);
+
+	if (!data || !data->wq)
+		return -ENODEV;
+	data->last_retrain = jiffies - 11 * HZ;	/* 手動は即実行 */
+	queue_work(data->wq, &data->retrain_work);
+	return count;
+}
+static DEVICE_ATTR_WO(retrain);
