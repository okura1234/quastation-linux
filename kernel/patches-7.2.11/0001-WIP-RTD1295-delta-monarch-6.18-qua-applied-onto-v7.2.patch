+	MISC_INT_FAIL, /* Bit28 */
+	MISC_INT_EN_FAN, /* Bit29 */
+	MISC_INT_FAIL, /* Bit30 */
+	MISC_INT_FAIL, /* Bit31 */
+	},
+	{
+	ISO_INT_FAIL, /* Bit0 */
+	ISO_INT_RVD, /* Bit1 */
+	ISO_INT_EN_UR0,	/* Bit2 */
+	ISO_INT_FAIL, /* Bit3 */
+	ISO_INT_FAIL, /* Bit4 */
+	ISO_INT_EN_IRDA, /* Bit5 */
+	ISO_INT_FAIL, /* Bit6 */
+	ISO_INT_RVD, /* Bit7 */
+	ISO_INT_EN_I2C0, /* Bit8 */
+	ISO_INT_RVD, /* Bit9 */
+	ISO_INT_FAIL, /* Bit10 */
+	ISO_INT_EN_I2C1, /* Bit11 */
+	ISO_INT_EN_RTC_HSEC, /* Bit12 */
