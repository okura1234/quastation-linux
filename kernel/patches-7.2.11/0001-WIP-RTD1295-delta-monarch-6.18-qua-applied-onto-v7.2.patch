+/* A skbuff with nr_frags needs nr_frags+1 entries in the tx queue */
+#define TX_FRAGS_READY_FOR(tp, nr_frags) \
+	(TX_SLOTS_AVAIL(tp) >= ((nr_frags) + 1))
