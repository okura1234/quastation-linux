+static inline void rtl_w1w0_phy(struct rtl8169_private *tp, int page,
+				int reg_addr, int p, int m)
+{
+	rtl_phy_write(tp, page, reg_addr,
+		      (rtl_phy_read(tp, page, reg_addr) | p) & ~m);
