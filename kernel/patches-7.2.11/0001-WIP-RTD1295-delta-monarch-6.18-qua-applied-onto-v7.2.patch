+static u32 __rtl8169_get_wol(struct rtl8169_private *tp)
+{
+	u32 wolopts = 0;
+
+	if (tp->wol_enable & WOL_MAGIC)
+		wolopts |= WAKE_MAGIC;
+
+	return wolopts;
