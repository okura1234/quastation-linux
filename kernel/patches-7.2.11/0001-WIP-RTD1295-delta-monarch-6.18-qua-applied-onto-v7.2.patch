+
+#ifndef IRQ_RTD129x_H_
+#define IRQ_RTD129x_H_
+
+#define IRQ_INMUX 32
+
+enum misc_int_en {
+	MISC_INT_FAIL = 0xFF,
+	MISC_INT_RVD = 0xFE,
+	MISC_INT_EN_FAN = 29,
+	MISC_INT_EN_I2C3 = 28,
+	MISC_INT_EN_GSPI = 27,
