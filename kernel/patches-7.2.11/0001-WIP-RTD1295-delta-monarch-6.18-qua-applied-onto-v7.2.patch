+	MISC_INT_EN_GPIOA = 19,
+	MISC_INT_EN_I2C4 = 15,
+	MISC_INT_EN_I2C5 = 14,
+	MISC_INT_EN_RTC_DATA = 12,
+	MISC_INT_EN_RTC_HOUR = 11,
+	MISC_INT_EN_RTC_MIN = 10,
+	MISC_INT_EN_UR2 = 7,
+	MISC_INT_EN_UR2_TO = 6,
+	MISC_INT_EN_UR1_TO = 5,
