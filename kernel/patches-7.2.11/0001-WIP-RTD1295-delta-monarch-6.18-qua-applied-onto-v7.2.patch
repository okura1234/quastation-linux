+} tx_desc_info = {
+	.checksum = {
+		.udp	= TD1_IP_CS | TD1_UDP_CS,
+		.tcp	= TD1_IP_CS | TD1_TCP_CS
+	},
+	.mss_shift	= TD1_MSS_SHIFT,
+	.opts_offset	= 1
+};
