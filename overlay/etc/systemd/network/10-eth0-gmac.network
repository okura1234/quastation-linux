# Internal GMAC (r8169, 98016000.ethernet). Most Qua Station units have no physical
# RJ45 for it; the driver probes but the link stays down, which is harmless.
[Match]
Driver=r8169
[Link]
RequiredForOnline=no
[Network]
DHCP=yes
MulticastDNS=yes
[DHCPv4]
RouteMetric=10
[IPv6AcceptRA]
RouteMetric=10
